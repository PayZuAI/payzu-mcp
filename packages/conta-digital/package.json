{
  "name": "payzu-mcp-conta-digital",
  "version": "0.1.0",
  "description": "MCP server for PayZu Conta Digital API. 14 tools: Pix in/out, TED, transferência interna, saldo, perfil, extrato. Works with Claude Desktop, Cursor, Continue.",
  "type": "module",
  "bin": {
    "payzu-mcp-conta-digital": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "payzu",
    "pix",
    "ted",
    "conta-digital",
    "brl",
    "fintech",
    "claude",
    "cursor",
    "ai-tools"
  ],
  "homepage": "https://docs.payzu.com.br/docs/conta-digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/PayZuPlus/payzu-mcp.git",
    "directory": "packages/conta-digital"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "axios": "^1.13.2",
    "envalid": "^8.1.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
