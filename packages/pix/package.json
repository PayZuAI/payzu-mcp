  "description": "MCP server for PayZu Pix Processamento API. 29 tools: Pix charges, withdrawals, transfers, callbacks, MED infractions. Works with Claude Desktop, Cursor, Continue.",
  "type": "module",
  "bin": {
    "payzu-mcp-pix": "./dist/index.js"
  },
  "main": "./dist/index.js",
