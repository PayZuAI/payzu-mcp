{
  "name": "payzu-pix",
  "version": "0.9.5",
  "description": "Opere sua conta PayZu Pix por IA: cobranças, saques, transferências, saldo, relatórios e infrações MED.",
  "settings": [
    {
      "name": "Token de API PayZu",
      "description": "Pegue no dashboard: web.payzu.com.br/developers/credentials.",
      "envVar": "PAYZU_TOKEN",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "payzu-pix": {
      "command": "npx",
      "args": [
        "-y",
        "@payzu/mcp-pix"
      ]
    }
  }
}
