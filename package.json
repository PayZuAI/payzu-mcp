{
  "name": "payzu-mcp-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "PayZu MCP servers monorepo (Pix Processamento + Conta Digital)",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "release": "pnpm -r --filter='./packages/*' publish --access=public"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.3"
    }
  }
}
